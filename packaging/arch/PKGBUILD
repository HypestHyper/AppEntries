# Maintainer: HypestHyper
pkgname=app-entries
_appid=io.github.HypestHyper.AppEntries
pkgver=1.0.3
pkgrel=1
pkgdesc="Hide, show and edit app launcher entries, autostart and AppImages (GTK 4)"
arch=('any')
url="https://github.com/HypestHyper/AppEntries"
license=('MIT' 'OFL-1.1' 'Apache-2.0')
depends=('python' 'python-gobject' 'gtk4')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "AppEntries-$pkgver"
    local appdir="$pkgdir/usr/share/$_appid"
    install -dm755 "$appdir"
    cp -r app_entries "$appdir/"
    find "$appdir" -name '__pycache__' -type d -prune -exec rm -rf {} +

    install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_appid" <<LAUNCHER
#!/bin/sh
PYTHONPATH="/usr/share/$_appid\${PYTHONPATH:+:\$PYTHONPATH}" exec python3 -m app_entries "\$@"
LAUNCHER
    ln -s "$_appid" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "data/$_appid.desktop" "$pkgdir/usr/share/applications/$_appid.desktop"
    install -Dm644 "data/$_appid.metainfo.xml" "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
    install -Dm644 "data/$_appid.gschema.xml" "$pkgdir/usr/share/glib-2.0/schemas/$_appid.gschema.xml"
    install -Dm644 "data/icons/hicolor/scalable/apps/$_appid.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_appid.svg"
    install -Dm644 "data/icons/hicolor/symbolic/apps/$_appid-symbolic.svg" \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/$_appid-symbolic.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 app_entries/ui/fonts/OFL-GoogleSansFlex.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-GoogleSansFlex"
    install -Dm644 app_entries/ui/fonts/LICENSE-MaterialSymbols.txt \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MaterialSymbols"
}
